SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Backend: verifies the access token on /chat (HS256 secret; ES256/RS256 use SUPABASE_URL JWKS)
SUPABASE_JWT_SECRET=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
OPENROUTER_API_KEY=
HIKESENSE_MODEL=openai/gpt-4o-mini
MAX_TOOL_CALLS=8
MAX_COST_USD=0.05
CHAT_LOG_PATH=logs/chat.jsonl
# Web (Next.js): server components read SUPABASE_URL / SUPABASE_ANON_KEY above
# (in docker compose SUPABASE_URL is overridden to host.docker.internal).
# The browser talks to :3000 only: Next proxies /sb/* to SUPABASE_URL and /api/chat to
# API_INTERNAL_URL (default http://127.0.0.1:8000; compose: http://api:8000), so one tunnel
# to :3000 serves the phone. Leave the NEXT_PUBLIC_* URLs empty (set only to bypass the proxy).
API_INTERNAL_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Own User-Agent for fetching group pages (scripts/build_groups_csv.py) and race pages of the live
# events search (robots.txt is checked against it); empty = a neutral project default.
# Add a contact (e.g. a project URL) here, never commit a personal one.
HIKESENSE_USER_AGENT=

# Testkonto für `make smoke` (`make smoke-user` legt smoke@hikesense.local lokal an).
# Eigenes, zufälliges Passwort eintragen; nie einchecken.
HIKESENSE_SMOKE_PASSWORD=

# Lokaler Admin (`make admin-user`, Anmeldename „admin“). Nur der bcrypt-Hash, nie das Passwort.
# In einfachen Anführungszeichen, sonst liest Docker Compose die $-Zeichen als Variablen. Erzeugen:
#   docker exec supabase_db_HikeSense psql -U postgres -Atc "select crypt('PASSWORT', gen_salt('bf', 10))"
HIKESENSE_ADMIN_PASSWORD_HASH=

# Auth Admin API (Konten sperren/bestätigen, Smoke-Nutzer anlegen). NUR für das Python-Backend,
# nie als NEXT_PUBLIC_*. Lokal: `npx supabase status` → SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Chat ohne Konto: Anfragen pro IP (IPv6 pro /64) und für alle Gäste zusammen, je 24 h.
HIKESENSE_GUEST_PER_DAY=10
HIKESENSE_GUEST_TOTAL_PER_DAY=200
# Anzahl Reverse-Proxys vor der Web-App, die X-Forwarded-For ergänzen (online z. B. 1). 0: der
# Header wird ignoriert (Next reicht ihn nur durch); dann teilen sich alle Gäste eine Zählung.
HIKESENSE_TRUSTED_PROXY_HOPS=0

# Optional LangSmith tracing (README "LangSmith (optional)"): on only with
# LANGSMITH_TRACING=true and an API key. When on, user messages, prompts and tool results are sent
# to LangChain Inc. (EU region). Never commit the key.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_PROJECT=hikesense
