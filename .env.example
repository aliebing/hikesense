SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
OPENROUTER_API_KEY=
# Web (Next.js): server components read SUPABASE_URL / SUPABASE_ANON_KEY above
# (in docker compose SUPABASE_URL is overridden to host.docker.internal).
# Browser code (later tasks) must use a URL the browser can reach:
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
