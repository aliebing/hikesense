SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Backend: verifies the access token on /chat (HS256 secret; ES256/RS256 use SUPABASE_URL JWKS)
SUPABASE_JWT_SECRET=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
OPENROUTER_API_KEY=
HIKEALL_MODEL=openai/gpt-4o-mini
MAX_TOOL_CALLS=8
MAX_COST_USD=0.05
CHAT_LOG_PATH=logs/chat.jsonl
# Web (Next.js): server components read SUPABASE_URL / SUPABASE_ANON_KEY above
# (in docker compose SUPABASE_URL is overridden to host.docker.internal).
# Browser code (later tasks) must use a URL the browser can reach:
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Own User-Agent for fetching group pages (scripts/build_groups_csv.py) and race pages of the live
# events search (robots.txt is checked against it); empty = a neutral project default.
# Add a contact (e.g. a project URL) here, never commit a personal one.
HIKEALL_USER_AGENT=
